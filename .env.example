# ── Required ─────────────────────────────────────────────────────────────
# A funded deployer key. NEVER commit the real value; keep it in .env, which is gitignored.
# Safer still: use `cast wallet import knot --interactive` and pass --account knot instead.
# PRIVATE_KEY is deliberately NOT used. Import your key once with:
#   cast wallet import uhi-deploy --interactive
# then pass --account uhi-deploy to forge script. See DEPLOY.md.

# ── Unichain Sepolia (chain 1301) — the default target ───────────────────
POOL_MANAGER=0x00b036b58a818b1bc34d502d3fe730db729e62ac
RPC_URL=https://sepolia.unichain.org

# ── Base Sepolia (chain 84532) — alternative ─────────────────────────────
# POOL_MANAGER=0x05E73354cFDd6745C338b50BcFDfA3Aa6fA03408
# RPC_URL=https://sepolia.base.org

# ── Deployment parameters ────────────────────────────────────────────────
LIQUIDITY_MATURITY_BLOCKS=1

# ── Filled in after phase one, needed by the Activate script ─────────────
DEEP_POOL=
SHALLOW_POOL=
