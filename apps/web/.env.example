# Chain identity and contract addresses come only from the validated manifest at
# deployments/unichain-sepolia.json. An RPC override may be useful if the public endpoint is busy.
NEXT_PUBLIC_RPC_URL=https://sepolia.unichain.org

# Live Mintlify docs. lib/site.ts already defaults to this, so it only needs
# setting if the docs move.
NEXT_PUBLIC_DOCS_URL=https://knot-38d8bd0e.mintlify.app
